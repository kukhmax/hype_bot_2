# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Получить: https://t.me/BotFather → /newbot

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Получить: https://aistudio.google.com/app/apikey (бесплатно)

# ── Торговая пара ─────────────────────────────────────────────────────────────
DEFAULT_SYMBOL=BTC_USDT
# MEXC Futures формат: BTC_USDT, ETH_USDT, SOL_USDT и т.д.

# ── Стратегия ─────────────────────────────────────────────────────────────────
MIN_PATTERNS_TO_SIGNAL=3      # 2-4: сколько паттернов нужно для сигнала
MIN_CONFIDENCE=65             # 50-90: мин. Confluence Score (%)
SIGNAL_COOLDOWN_SEC=900       # 900 = 15 мин между сигналами
CONFIRM_TIMEOUT_SEC=300       # 300 = 5 мин на подтверждение входа

# ── Индикаторы ────────────────────────────────────────────────────────────────
ATR_PERIOD=14
ADX_PERIOD=14
RSI_PERIOD=14
CCI_PERIOD=20

# ── Логирование ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
