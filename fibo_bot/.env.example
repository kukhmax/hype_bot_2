# ============================================
# Fibo Bot — Переменные окружения
# ============================================

# --- MEXC Exchange ---
MEXC_API_KEY=
MEXC_API_SECRET=
MARKET_TYPE=futures

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=123456789

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fibo_bot
POSTGRES_USER=fibo_bot
POSTGRES_PASSWORD=fibo_bot_secret

# --- Trading ---
SYMBOLS=SOL_USDT,ETH_USDT
DEFAULT_TIMEFRAME=5m
RISK_PER_TRADE=0.01
TRADING_MODE=balanced

# --- General ---
LOG_LEVEL=INFO
DEBUG=false
